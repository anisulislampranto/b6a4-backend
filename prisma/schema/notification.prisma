model Notification {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  message   String
  href      String?

  metadata  Json?
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
